{
  "manifest_version": 3,
  "name": "Ferna Feeds",
  "short_name": "Ferna Feeds",
  "version": "1.0.1",
  "description": "Smart RSS and news reader: Sri Lankan, world, research and tech streams, one card per story, summaries and offline reading.",
  "author": "Ferna Software Solutions",
  "homepage_url": "https://tgi25.github.io/ferna-software/",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ferna Feeds",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "feeds.html?panel=1"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "feeds.html#manage",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "sidePanel",
    "contextMenus",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/discover.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Open Ferna Feeds"
    }
  }
}