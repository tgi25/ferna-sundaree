{
  "manifest_version": 3,
  "name": "Ferna Test Extension",
  "version": "1.2.3",
  "description": "Test extension for Ferna Sundaree: popup, badge, content script.",
  "action": { "default_popup": "popup.html", "default_title": "Ferna test", "default_icon": "icon.png" },
  "icons": { "48": "icon.png" },
  "background": { "service_worker": "sw.js" },
  "permissions": ["storage"],
  "content_scripts": [{ "matches": ["http://127.0.0.1/*"], "js": ["cs.js"], "run_at": "document_end" }]
}
